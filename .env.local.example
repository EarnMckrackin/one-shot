# Supabase (create a new project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ComicVine — register free at comicvine.gamespot.com, get key from your profile
COMICVINE_API_KEY=your-comicvine-api-key

# Anthropic — Claude Vision for cover scanning
ANTHROPIC_API_KEY=sk-ant-...

# Metron Comic Database — register free at metron.cloud (no token needed, just your login)
METRON_USERNAME=your-metron-username
METRON_PASSWORD=your-metron-password

# Google Drive OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# AES-256 key for encrypting Google tokens in Supabase (any 32-char string)
ENCRYPTION_KEY=your-32-char-encryption-key-here
